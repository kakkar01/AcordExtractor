# Runtime backend
INFERENCE_BACKEND=api

# OpenAI-compatible structured extraction backend
API_BASE_URL=https://auction-upon-briskly.ngrok-free.dev/v1
API_KEY=
API_MODEL=numind/NuExtract3
API_INPUT_MODE=completion
API_MAX_NEW_TOKENS=4096
API_TIMEOUT_SECONDS=90
API_MAX_RETRIES=1
API_PAGE_TEXT_MAX_CHARS=5000
OCR_MAX_NEW_TOKENS=4096
API_IMAGE_MAX_DIM=1280
API_IMAGE_JPEG_QUALITY=90
API_IMAGE_JPEG_SUBSAMPLING=0
API_SAVE_REQUEST_IMAGES=0
API_REQUEST_IMAGES_DIR=data/debug_images
API_FIELD_REASONING=1
API_FIELD_REASONING_MAX=12

# Docling OCR
DOCLING_SERVE_URL=http://localhost:8000
DOCLING_SERVE_API_KEY=
DOCLING_SERVE_CONVERT_PATH=/v1/convert/source
DOCLING_TIMEOUT_SECONDS=120
DOCLING_USE_LOCAL=0

# ACORD 125 LOB refinement
LOB_REFINEMENT_CROP=0
LOB_CROP_LEFT_RATIO=0.02
LOB_CROP_TOP_RATIO=0.27
LOB_CROP_RIGHT_RATIO=0.98
LOB_CROP_BOTTOM_RATIO=0.57
LOB_SAVE_CROP_IMAGE=0
LOB_CROP_IMAGES_DIR=data/debug_lob_crops
API_SAVE_LOB_CROP=0
API_LOB_CROP_DIR=data/debug_images/lob_crops
API_LOB_CROP_LEFT=0.02
API_LOB_CROP_TOP=0.28
API_LOB_CROP_RIGHT=0.98
API_LOB_CROP_BOTTOM=0.56

# Local model path settings
PDF_DPI=170
MAX_NEW_TOKENS=768
TEMPERATURE_NO_THINK=0.0
TEMPERATURE_THINK=0.0
DEVICE_MAP=auto
